rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
      allow delete: if false;
    }
    match /ports/{portId}/cleaning_records/{recordId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['port_id', 'user_id', 'completed_at'])
        && request.resource.data.port_id == portId
        && request.resource.data.user_id is string
        && request.resource.data.completed_at is string;
      allow update, delete: if false;
    }
  }
}
